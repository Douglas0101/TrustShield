# 1. Crie ou atualize seu arquivo .gitignore na raiz do projeto.
# Certifique-se de que ele contenha as seguintes linhas:
echo "
# MLOps Artifacts & Cache
mlruns/
outputs/
cache/
Saida_Algoritmo.txt

# Python cache
__pycache__/
*.pyc

# IDE files
.idea/
.vscode/
" >> .gitignore

# 2. Remova os diretórios do tracking do Git (sem apagá-los do seu disco)
git rm -r --cached mlruns/
git rm -r --cached outputs/
git rm -r --cached cache/
git rm --cached Saida_Algoritmo.txt

# 3. Faça o commit desta limpeza
git add .gitignore
git commit -m "chore: Adiciona artefatos de ML e cache ao .gitignore"

echo "✅ Repositório higienizado. Artefatos não serão mais versionados."